<!--
  Compiler settings every functional core project needs. Shared by FunctionalCore.props (source setup)
  and the NuGet package (shipped as build/FunctionalLint.props), so both behave the same.
-->
<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <!-- Every warning is an error: a warning is often a real bug (CS8907 "parameter is unread" once hid an
         infinite recursion). Nullable warnings and non-exhaustive switches (CS8509) are included. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);nullable;CS8509</WarningsAsErrors>
    <!-- Except rules you've deliberately set to "warning" while migrating, which should stay warnings:
         FunctionalLint's own rules and the culture rules below. NuGet security advisories stay visible
         without blocking the build. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);FP0001;FP0002;FP0003;FP0004;FP0005;FP0006;FP0007;FP0008;FP0009;FP0010;FP0011;FP0012;FP0013;FP0014;FP0015;CA1304;CA1305;CA1309;CA1310;CA1311;NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <!-- CS8524 wants a discard arm for unnamed enum values. That arm would hide
         missing cases, so turn it off and let CS8509 do the work. -->
    <NoWarn>$(NoWarn);CS8524</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)FunctionalCore.globalconfig" />
  </ItemGroup>

</Project>
