<!--
  Import this into every functional core project:

    <Import Project="..\FunctionalLint\build\FunctionalCore.props" />

  Leave it out of host, adapter-only and test projects.
  (Or use the NuGet package instead; see README.)
-->
<Project>

  <Import Project="$(MSBuildThisFileDirectory)FunctionalCore.Settings.props" />

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\FunctionalLint\FunctionalLint.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <!-- Code fixes: used by the IDE light bulb and by heal.sh. -->
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\FunctionalLint.CodeFixes\FunctionalLint.CodeFixes.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)functional.globalconfig" />
  </ItemGroup>

</Project>
