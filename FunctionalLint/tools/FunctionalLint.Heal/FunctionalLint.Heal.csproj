<Project Sdk="Microsoft.NET.Sdk">

  <!-- Loads a project once, applies FunctionalLint's code fixes in memory, writes the files,
       and reports what's left. See heal.sh. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- Measured with tools/scale-test.sh (docs/performance.md): a check is a short burst of heavy work on every core,
         so profile-guided tiering only adds rejits, and the server GC keeps up with the allocation. Together they
         take a 61,000-line core from 28 s to 16 s, and a small one from 4.9 s to 4.2 s. -->
    <TieredPGO>false</TieredPGO>
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FunctionalLint\FunctionalLint.csproj" />
    <ProjectReference Include="..\..\src\FunctionalLint.CodeFixes\FunctionalLint.CodeFixes.csproj" />
  </ItemGroup>

</Project>
